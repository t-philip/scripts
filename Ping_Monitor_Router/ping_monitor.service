cat > ~/ping_monitor/ping_monitor.service << 'EOF'
[Unit]
Description=Wi-Fi Mesh Router Ping Monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/root/ping_monitor/ping_monitor.sh
Restart=on-failure
RestartSec=30
StandardOutput=null
StandardError=journal

[Install]
WantedBy=multi-user.target
EOF